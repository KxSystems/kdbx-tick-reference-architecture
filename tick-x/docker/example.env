# Settings for tick-x/docker/compose.yaml. Every value is optional; the defaults
# match samples/sample_env. To customise:
#   cp example.env .env      (.env is gitignored; compose reads it automatically)

# Licence file mounted into the containers as $QLIC/kc.lic
KX_LICENSE_FILE=${HOME}/.kx/kc.lic

# Base image (any official kdbx-q variant)
BASE_IMAGE=portal.dl.kx.com/kdbx-q:5.0.20260723-rocky9-r1

# Secondary threads per process (startup.sh -s)
SECONDARIES=0

LOG_LEVEL=info

# Ports: used both inside the containers and published on 127.0.0.1
TICK_PORT=5010
RDB_PORT=5011             # main RDB (writedown role)
HDB_PORT=5012
GW_PORT=5013
FH_PORT=5014
IDB_PORT=5015
RTE_PORT=5016
CHAINED_RDB_PORT=5017     # chained RDB (query role)

# Main RDB flushes int-partitions to the IDB every N minutes (minimum 1)
FLUSH_INTV_MIN=5

# Feedhandler publish interval in ms
FH_TIMER=60000
