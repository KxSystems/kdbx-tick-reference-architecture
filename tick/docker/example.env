# Settings for tick/docker/compose.yaml. Every value is optional; the defaults
# match samples/sample_env. To customise:
#   cp example.env .env      (.env is gitignored; compose reads it automatically)

# Licence directory mounted read-only at /run/secrets/kx (the image's QLIC).
# Defaults to $QLIC if you have it set, else ~/.kx. Uncomment to use another.
# QLIC=${HOME}/.kx

# Base image (any official kdbx-q variant)
BASE_IMAGE=portal.dl.kx.com/kdbx-q:5.0.20260723-rocky9-r1

# Secondary threads per process (startup.sh -s)
SECONDARIES=0

LOG_LEVEL=info

# Ports: used both inside the containers and published on 127.0.0.1
TICK_PORT=5010
RDB_PORT=5011
HDB_PORT=5012
GW_PORT=5013
FH_PORT=5014
RTE_PORT=5016

# Feedhandler publish interval in ms
FH_TIMER=60000
